# Copy to `.env` and fill in. Secrets never travel: .env is gitignored.
#
# dvara reads its model settings through Yantra, so every YANTRA/provider
# variable works here unchanged. The service's own knobs are the four
# below.

# The bearer token `dvara serve` requires. At least 16 characters; the
# service refuses to start without one. Generate with:
#   openssl rand -hex 24
# DVARA_TOKEN=

# The OWNER-CONTROLLED directory of agent packages. Agents are named,
# never pathed: nothing arriving from a caller can reach outside it.
# DVARA_ROOT=~/dvara/agents

# Who this service serves.
# DVARA_ACTORS=~/dvara/actors.toml

# Standing allow/deny/ask rules, matched per tool call. Optional: with no
# policy file every call that could change something is decided by the
# rung alone. Named here it must exist; ~/dvara/policy.toml is used if it
# happens to be there.
# DVARA_POLICY=~/dvara/policy.toml

# Sessions, run history and per-conversation workspaces.
# DVARA_STATE=~/dvara/state

# The bot token `dvara telegram` requires, one per bot, from BotFather.
# There is deliberately no --token flag: a credential on a command line
# is in your shell history and readable in every `ps` on the box. One bot
# is ONE agent -- a token is an identity with a name and an @handle, so a
# second agent is a second token here and a second process, rather than a
# prefix on every message you send.
# TELEGRAM_TOKEN=

# ---- models ---------------------------------------------------------------
# A local box costs nothing and keeps every conversation on hardware you
# own. Anything Yantra supports works; the service picks, not the package.
#
# NOTE THE /v1. Ollama is reached through the OpenAI dialect, whose
# BASE_URL INCLUDES the version segment -- the adapter appends
# /chat/completions to whatever is set here. Drop it and every turn comes
# back as "404 page not found", because an uncommented line beats a
# correct default. Yantra's own default is the line below, so the usual
# right answer is to leave it commented.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3.8-64k:latest
#
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
